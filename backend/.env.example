# GO BEYOND Backend Environment Configuration Template
PROJECT_NAME="GO BEYOND"
ENVIRONMENT=development
DEBUG=True
COOKIE_SECURE=False
API_V1_STR="/api/v1"

# Security & Authentication (Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY="<GENERATE_RANDOM_SECRET>"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DATABASE_URL="sqlite:///./gobeyond.db"
# PostgreSQL example: postgresql://gobeyond_user:<PASSWORD>@localhost:5432/gobeyond_db

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
USE_MEMORY_LOCK_FALLBACK=False
LOCK_EXPIRY_SECONDS=600

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID="<RAZORPAY_TEST_KEY_ID>"
RAZORPAY_KEY_SECRET="<RAZORPAY_TEST_KEY_SECRET>"
RAZORPAY_SANDBOX_MODE=True

# OTP Service
OTP_SANDBOX_MODE=True
OTP_DEFAULT_DEV_CODE="123456"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:3000","http://127.0.0.1:3000"]
