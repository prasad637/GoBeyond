from sqlalchemy import Column, Integer, String, Boolean, Float, ForeignKey, Date, Time, Text, JSON
from sqlalchemy.orm import relationship
from app.core.database import Base
from app.models.base import TimestampMixin


class SportsVenue(Base, TimestampMixin):
    __tablename__ = "sports_venues"

    id = Column(Integer, primary_key=True, index=True)
    partner_id = Column(Integer, ForeignKey("partners.id", ondelete="CASCADE"), nullable=False)
    location_id = Column(Integer, ForeignKey("locations.id"), nullable=False)
    name = Column(String(255), nullable=False)
    sport_types = Column(JSON, default=list)  # ["Cricket", "Football", "Badminton", "Tennis"]
    address = Column(String(500), nullable=False)
    amenities = Column(JSON, default=list)  # ["Floodlights", "Locker Room", "Parking", "Cafeteria"]
    images = Column(JSON, default=list)
    rating = Column(Float, default=4.5, nullable=False)
    is_active = Column(Boolean, default=True, nullable=False)

    partner = relationship("Partner", back_populates="sports_venues")
    location = relationship("Location")
    activities = relationship("Activity", back_populates="venue", cascade="all, delete-orphan")


class Activity(Base, TimestampMixin):
    __tablename__ = "activities"

    id = Column(Integer, primary_key=True, index=True)
    partner_id = Column(Integer, ForeignKey("partners.id", ondelete="CASCADE"), nullable=False)
    location_id = Column(Integer, ForeignKey("locations.id"), nullable=False)
    venue_id = Column(Integer, ForeignKey("sports_venues.id"), nullable=True)
    title = Column(String(255), nullable=False)
    slug = Column(String(280), unique=True, index=True, nullable=False)
    category = Column(String(100), nullable=False)  # SPORTS, GAMING_ZONE, AMUSEMENT, ADVENTURE
    description = Column(Text, nullable=True)
    base_price = Column(Float, nullable=False)
    duration_minutes = Column(Integer, default=60, nullable=False)
    image_url = Column(String(500), nullable=True)
    min_age = Column(Integer, default=5, nullable=False)
    is_active = Column(Boolean, default=True, nullable=False)

    partner = relationship("Partner", back_populates="activities")
    location = relationship("Location")
    venue = relationship("SportsVenue", back_populates="activities")
    slots = relationship("ActivitySlot", back_populates="activity", cascade="all, delete-orphan")


class ActivitySlot(Base, TimestampMixin):
    __tablename__ = "activity_slots"

    id = Column(Integer, primary_key=True, index=True)
    activity_id = Column(Integer, ForeignKey("activities.id", ondelete="CASCADE"), nullable=False)
    slot_date = Column(Date, nullable=False)
    start_time = Column(Time, nullable=False)
    end_time = Column(Time, nullable=False)
    capacity = Column(Integer, default=10, nullable=False)
    booked_count = Column(Integer, default=0, nullable=False)
    price_override = Column(Float, nullable=True)
    is_available = Column(Boolean, default=True, nullable=False)

    activity = relationship("Activity", back_populates="slots")

