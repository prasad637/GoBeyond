import json
import os
from pathlib import Path
from typing import List, Union
from pydantic import AnyHttpUrl, field_validator
from pydantic_settings import BaseSettings, SettingsConfigDict

_BASE_DIR = Path(__file__).resolve().parent.parent.parent
_DEFAULT_DB_PATH = (_BASE_DIR / "gobeyond.db").as_posix()


class Settings(BaseSettings):
    PROJECT_NAME: str = "GO BEYOND"
    VERSION: str = "1.0.0"
    ENVIRONMENT: str = "development"
    DEBUG: bool = True
    API_V1_STR: str = "/api/v1"

    # Security
    SECRET_KEY: str = "gobeyond-super-secret-jwt-key-for-development-change-in-production-2026"
    ALGORITHM: str = "HS256"
    ACCESS_TOKEN_EXPIRE_MINUTES: int = 1440

    # Database
    DATABASE_URL: str = f"sqlite:///{_DEFAULT_DB_PATH}"

    # Redis & Locks
    REDIS_URL: str = "redis://localhost:6379/0"
    USE_MEMORY_LOCK_FALLBACK: bool = True
    LOCK_EXPIRY_SECONDS: int = 600  # 10 minutes temporary seat/slot lock

    # Razorpay Payment Gateway
    RAZORPAY_KEY_ID: str = "rzp_test_GoBeyondDemo2026"
    RAZORPAY_KEY_SECRET: str = "GoBeyondTestSecretKey2026"
    RAZORPAY_SANDBOX_MODE: bool = True

    # OTP Provider
    OTP_SANDBOX_MODE: bool = True
    OTP_DEFAULT_DEV_CODE: str = "123456"

    # Initial Launch Location
    DEFAULT_CITY: str = "Hyderabad"
    DEFAULT_STATE: str = "Telangana"
    DEFAULT_COUNTRY: str = "India"

    # CORS
    BACKEND_CORS_ORIGINS: Union[List[str], str] = [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
    ]

    @field_validator("BACKEND_CORS_ORIGINS", mode="before")
    @classmethod
    def assemble_cors_origins(cls, v: Union[str, List[str]]) -> List[str]:
        if isinstance(v, str) and not v.startswith("["):
            return [i.strip() for i in v.split(",")]
        elif isinstance(v, str):
            return json.loads(v)
        return v

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=True,
        extra="ignore"
    )


settings = Settings()
