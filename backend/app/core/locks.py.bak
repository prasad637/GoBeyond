import time
import threading
from typing import Optional, Dict, Tuple
import redis
from app.core.config import settings

class InMemoryLockManager:
    """Thread-safe in-memory lock manager used for development and testing fallback."""
    def __init__(self):
        self._locks: Dict[str, Tuple[str, float]] = {}  # key -> (token, expire_timestamp)
        self._mutex = threading.Lock()

    def acquire(self, key: str, token: str, expiry_seconds: int = 600) -> bool:
        with self._mutex:
            now = time.time()
            # Clean expired lock if any
            if key in self._locks:
                current_token, expires_at = self._locks[key]
                if now >= expires_at:
                    del self._locks[key]
                else:
                    return False
            self._locks[key] = (token, now + expiry_seconds)
            return True

    def release(self, key: str, token: str) -> bool:
        with self._mutex:
            if key in self._locks:
                current_token, _ = self._locks[key]
                if current_token == token:
                    del self._locks[key]
                    return True
            return False

    def is_locked(self, key: str) -> bool:
        with self._mutex:
            now = time.time()
            if key in self._locks:
                _, expires_at = self._locks[key]
                if now < expires_at:
                    return True
                else:
                    del self._locks[key]
            return False

    def get_all_locked(self, prefix: str = "") -> list:
        with self._mutex:
            now = time.time()
            active = []
            for k, (t, exp) in list(self._locks.items()):
                if now < exp:
                    if not prefix or k.startswith(prefix):
                        active.append(k)
                else:
                    del self._locks[k]
            return active


class LockService:
    def __init__(self):
        self.redis_client: Optional[redis.Redis] = None
        self.memory_manager = InMemoryLockManager()
        self._init_redis()

    def _init_redis(self):
        try:
            client = redis.from_url(settings.REDIS_URL, decode_responses=True, socket_connect_timeout=1)
            client.ping()
            self.redis_client = client
        except Exception:
            # Fallback to in-memory lock manager
            self.redis_client = None

    def acquire_lock(self, key: str, token: str, expiry_seconds: Optional[int] = None) -> bool:
        ttl = expiry_seconds or settings.LOCK_EXPIRY_SECONDS
        if self.redis_client:
            try:
                # SET key token NX EX ttl
                result = self.redis_client.set(f"gobeyond:lock:{key}", token, nx=True, ex=ttl)
                return bool(result)
            except Exception:
                pass
        return self.memory_manager.acquire(key, token, ttl)

    def release_lock(self, key: str, token: str) -> bool:
        if self.redis_client:
            try:
                redis_key = f"gobeyond:lock:{key}"
                current = self.redis_client.get(redis_key)
                if current == token:
                    self.redis_client.delete(redis_key)
                    return True
                return False
            except Exception:
                pass
        return self.memory_manager.release(key, token)

    def is_locked(self, key: str) -> bool:
        if self.redis_client:
            try:
                return bool(self.redis_client.exists(f"gobeyond:lock:{key}"))
            except Exception:
                pass
        return self.memory_manager.is_locked(key)

    def get_locked_keys(self, prefix: str = "") -> list:
        if self.redis_client:
            try:
                pattern = f"gobeyond:lock:{prefix}*"
                return [k.replace("gobeyond:lock:", "") for k in self.redis_client.keys(pattern)]
            except Exception:
                pass
        return self.memory_manager.get_all_locked(prefix)


lock_service = LockService()

